<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digital Transaction Value Snapshot | ETHSwitch</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <link rel="stylesheet" href="/css/report.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: { 50:'#f0f4fa', 100:'#d9e2f0', 200:'#b3c5e1', 300:'#8da8d2', 400:'#678bc3', 500:'#416eb4', 600:'#2d5190', 700:'#1e3a6b', 800:'#142750', 900:'#0B2A5B', 950:'#061630' },
            brand: { 50:'#fff3ed', 100:'#ffe4d4', 200:'#ffc5a8', 300:'#ff9d70', 400:'#ff6b36', 500:'#F4511E', 600:'#e03a08', 700:'#b82a06', 800:'#93240c', 900:'#7a210e' }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-100 font-sans min-h-screen">
  <div class="min-h-screen">
    <nav class="bg-navy-900 text-white shadow-lg print-hide">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">
          <div class="flex items-center gap-3">
            <i data-lucide="bar-chart-3" class="w-6 h-6 text-brand-400"></i>
            <span class="font-bold text-lg tracking-tight">ETHSwitch Report Tools</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-navy-200">
            <i data-lucide="calendar" class="w-4 h-4"></i>
            <span id="nav-date"></span>
          </div>
        </div>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 print-hide">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-lg bg-brand-500 flex items-center justify-center">
          <i data-lucide="file-text" class="w-5 h-5 text-white"></i>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-navy-900">Digital Transaction Value Snapshot</h1>
          <p class="text-sm text-gray-500">Configure and generate professional transaction reports</p>
        </div>
      </div>

      <%- include('partials/form', { data: data, availableIcons: availableIcons }) %>
    </div>

    <div class="print-area" id="print-area">
      <%- include('partials/report-preview', { data: data }) %>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
