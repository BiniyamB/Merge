<div class="report-header">
  <div class="header-left">
    <div class="org-badge">
      <div class="org-icon">ES</div>
      <div>
        <div class="org-name" id="r-org"><%= data.report.organization %></div>
        <div class="org-sub">SWITCH COMPANY</div>
      </div>
    </div>
  </div>
  <div class="header-center">
    <div class="brand-badge" id="r-brand"><%= data.report.brand %></div>
    <h1 class="report-title" id="r-title"><%= data.report.title %></h1>
    <p class="report-subtitle" id="r-subtitle"><%= data.report.subtitle %></p>
  </div>
  <div class="header-right">
    <div class="date-badge">
      <span class="date-label">DATE</span>
      <span class="date-value" id="r-date"><%= data.report.date %></span>
    </div>
  </div>
</div>